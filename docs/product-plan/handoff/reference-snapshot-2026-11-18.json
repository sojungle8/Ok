  "announcements": [
    {
      "announcementId": "hans-20261118-v0135",
      "sourceId": "hans.news.20261118-v0135",
      "sourceVersion": "V0.13.5",
      "titleSummary": "節慶內容、雙王與闖入者、角色改名、待選升級保存、聊天泡泡及連線限制更新",
      "factSummaries": [
        "節慶關卡加入雙王與闖入者事件，並擴充活動裝備。",
        "一周目後提供角色改名流程。",
        "暫停選單可保存尚未處理的升級選擇與寶箱。",
        "主城和組隊遠征加入聊天泡泡及配裝查看入口。",
        "營運公告調整同網路同時遊玩與新帳號開放量。"
      ],
      "categories": ["content", "account", "persistence", "social", "multiplayer"],
      "confidence": "observed",
      "copyrightClass": "text-do-not-copy",
      "supersedesObservationIds": ["OBS-20261117-HANS-002"]
    },
    {
      "announcementId": "hans-20261118-notice-r29",
      "sourceId": "hans.notice.20261118-r29",
      "sourceVersion": "rev-29",
      "revision": 29,
      "titleSummary": "周目暫停擴張並轉向新章節與爬塔，同時調整拾取、信件與穩定性",
      "factSummaries": [
        "營運方表示目前進度到六周目，短期不再增加周目與裝備。",
        "後續內容方向轉向新章節與爬塔。",
        "一般怪裝備件數改為實際拾取後計入。",
        "信件依是否有附件設定不同保留期限。",
        "公告列出存檔、掉落、載入與重新連線後升級流程的修正。"
      ],
      "categories": ["content", "economy", "mail", "bugfix", "performance"],
      "confidence": "observed",
      "copyrightClass": "text-do-not-copy",
      "supersedesObservationIds": []
    }
  ],
