# Copy to .env.local (git-ignored) and replace the fake values. Never commit real paths.
RO_ASSET_SOURCE_DATA_GRF=C:\path\to\data.grf
RO_ASSET_SOURCE_RDATA_GRF=C:\path\to\rdata.grf
RO_ASSET_BGM_DIR=C:\path\to\BGM
RO_ASSET_GATEWAY_HOST=127.0.0.1
RO_ASSET_GATEWAY_PORT=4178
# Only for an explicit private-LAN profile (Phase 3+); leave empty for loopback.
RO_ASSET_GATEWAY_LAN_CIDR=

# Read-only fingerprints of the previous RO trees (pnpm local:old-trees). Never modified.
RO_OLD_TREE_AMATSU=C:\path\to\RO-Amatsu
RO_OLD_TREE_SERVER=C:\path\to\RO-Server
RO_OLD_TREE_ROBROWSER_LEGACY=C:\path\to\RO-Server\browser-research\roBrowserLegacy
RO_OLD_TREE_REMOTE_CLIENT=C:\path\to\RO-Server\browser-research\remote-client

# fan-local (default) | original-fallback | fan-public (fails without docs/release/fan-public-approval.md)
RO_BUILD_PROFILE=fan-local
